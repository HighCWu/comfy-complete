# Experimental Pod launcher. The immutable ComfyComplete runtime is supplied by
# the managed Network Volume and verified before the existing Pod supervisor runs.
# The runtime archive already contains PyTorch's CUDA user-space libraries.
# RunPod injects the host driver libraries/devices at container start, so the
# launcher needs only the audited Ubuntu/glibc contract—not another 3GB CUDA
# runtime layer.
FROM ubuntu:24.04@sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467

ARG LAUNCHER_DIGEST
ARG LAUNCHER_ABI=comfy-pod-launcher/v1

RUN test -n "${LAUNCHER_DIGEST}" && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils dumb-init grep python3 sed && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app /opt /launcher-lib

COPY --chmod=755 docker/pod/runtime_launcher.py /runtime-launcher.py
COPY --chmod=644 scripts/runtime_manifest.py /launcher-lib/runtime_manifest.py
COPY --chmod=755 docker/pod/start.sh /start-pod.sh
COPY --chmod=644 docker/pod/gateway.py /pod-gateway.py
COPY --chmod=644 docker/pod/model_bootstrap.py /pod-model-bootstrap.py
COPY --chmod=644 docker/pod/asset_sync.py /pod-asset-sync.py
COPY --chmod=755 docker/runpod/comfy-manager-set-mode.sh /usr/local/bin/comfy-manager-set-mode

ENV COMFY_INTERNAL_HOST=127.0.0.1 \
    COMFY_INTERNAL_PORT=8188 \
    LAIMON_POD_PORT=8189 \
    COMFY_LOG_LEVEL=INFO \
    LAIMON_EXPECTED_LAUNCHER_DIGEST=${LAUNCHER_DIGEST} \
    LAIMON_EXPECTED_LAUNCHER_ABI=${LAUNCHER_ABI} \
    LAIMON_EXPECTED_RUNTIME_PLATFORM=linux/amd64

EXPOSE 8189
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/runtime-launcher.py"]
